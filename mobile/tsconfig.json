{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "next/link": ["./src/compat/link.tsx"],
      "next/image": ["./src/compat/image.tsx"],
      "next/navigation": ["./src/compat/navigation.ts"],
      "@/lib/supabase/server": ["./src/supabase.ts"],
      "@/lib/catalog": ["./src/data.ts"],
      "@/lib/address-server": ["./src/data.ts"],
      "@/lib/profile-server": ["./src/data.ts"],
      "@/lib/shipping-server": ["./src/data.ts"],
      "@/lib/store-content-server": ["./src/data.ts"],
      "@/app/auth/actions": ["./src/actions/auth.ts"],
      "@/app/account/actions": ["./src/actions/account.ts"],
      "@/app/checkout/actions": ["./src/actions/checkout.ts"],
      "@/components/share-app": ["./src/native-share.tsx"],
      "@/components/delete-account": ["./src/native-delete-account.tsx"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["dist", "../node_modules"]
}

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server only: required for the existing site_settings content editor.
SUPABASE_SECRET_KEY=
# Optional public sharing URL for the Android app; defaults to its Play Store listing.
VITE_PUBLIC_STORE_URL=
# Server only: base64 of the Firebase Admin SDK service-account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Server only: shared with Supabase Vault secret daciana_order_push_secret.
ORDER_PUSH_WEBHOOK_SECRET=
# Server only: transactional order emails. Auth emails use Resend SMTP in Supabase.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Daciana <noreply@dacianastore.in>"
RESEND_REPLY_TO=luwangtech0@gmail.com
# Native app API host; defaults to https://dacianastore.in. No secrets here.
VITE_API_URL=https://dacianastore.in

{
  "name": "darciana",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:admin-ui": "playwright test --config=playwright.admin.config.ts",
    "mobile:dev": "vite --config mobile/vite.config.ts --host 127.0.0.1",
    "mobile:typecheck": "tsc -p mobile/tsconfig.json --noEmit",
    "mobile:build": "npm run mobile:typecheck && vite build --config mobile/vite.config.ts && node scripts/check-mobile-build.mjs",
    "mobile:preview": "vite preview --config mobile/vite.config.ts --host 127.0.0.1",
    "android:sync": "npm run mobile:build && cap sync android",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor '#faf9f7' --iconBackgroundColorDark '#faf9f7' --splashBackgroundColor '#faf9f7' --splashBackgroundColorDark '#faf9f7' --logoSplashScale 0.5",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && node scripts/android-build.mjs assembleDebug",
    "android:bundle": "npm run android:sync && node scripts/android-build.mjs bundleRelease",
    "android:release-apk": "npm run android:sync && node scripts/android-build.mjs assembleRelease",
    "android:upload-key": "node scripts/create-upload-key.mjs",
    "test:mobile-ui": "playwright test --config=playwright.mobile.config.ts",
    "check:auth-redirects": "node --experimental-strip-types scripts/check-auth-redirects.mjs",
    "storage:setup": "node --experimental-strip-types scripts/setup-storage.mjs",
    "format": "prettier --write src mobile/src mobile/vite.config.ts mobile/tsconfig.json mobile/index.html docs tests scripts supabase/functions/delete-account/*.{mjs,ts,json} *.ts *.json *.mjs README.md .prettierrc.json",
    "format:check": "prettier --check src mobile/src mobile/vite.config.ts mobile/tsconfig.json mobile/index.html docs tests scripts supabase/functions/delete-account/*.{mjs,ts,json} *.ts *.json *.mjs README.md .prettierrc.json"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/network": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.106.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase-admin": "14.5.0",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "^5",
    "vite": "8.3.6"
  }
}
